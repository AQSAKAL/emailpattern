---
import { Check, CircleCheck } from "lucide-react"
import { AddressFormat } from "@/components/AddressFormat"
import { CodeTabs } from "@/components/CodeTabs"
import { Finder } from "@/components/Finder"
import LinkButton from "@/components/site/LinkButton.astro"
import LogoStrip from "@/components/site/LogoStrip.astro"
import SectionHeading from "@/components/site/SectionHeading.astro"
import { Badge } from "@/components/ui/badge"
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from "@/components/ui/table"
import { LOCALES, dictionary, localePath, patternLabel, type Locale } from "@/i18n"
import Base from "@/layouts/Base.astro"
import { parseName } from "@/lib/email/names"
import { PATTERNS, applyTemplate } from "@/lib/email/patterns"
import { apiSamples, mcpSamples } from "@/lib/samples"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = dictionary(locale)
const origin = Astro.site!.origin
const home = localePath(locale, "/")
const person = parseName(t.examplePerson.name)!
const topPatterns = PATTERNS.slice(0, 6)
const endpoints = [
  { method: "GET", path: "/api/v1/find?domain=&name=" },
  { method: "POST", path: "/api/v1/find" },
  { method: "GET", path: "/api/v1/domains/{domain}" },
  { method: "GET", path: "/api/openapi.json" },
]

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebApplication",
    name: "EmailPattern",
    url: new URL(home, Astro.site).href,
    applicationCategory: "BusinessApplication",
    description: t.site.description,
    inLanguage: LOCALES[locale].htmlLang,
    isAccessibleForFree: true,
    offers: { "@type": "Offer", price: "0", priceCurrency: "EUR" },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: t.home.faq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
]
---

<Base locale={locale} title={t.home.metaTitle} description={t.site.description} path="/" jsonLd={jsonLd}>
  <section id="find" class="scroll-mt-20 bg-gradient-to-b from-band to-background">
    <div class="mx-auto flex max-w-6xl flex-col gap-10 px-4 pt-16 pb-16 sm:px-6 sm:pt-24">
      <div class="flex max-w-3xl flex-col gap-5">
        <Badge variant="outline" className="h-7 gap-1.5 self-start bg-background px-3 text-sm font-medium">
          <CircleCheck className="size-3.5 text-positive" />
          {t.home.badge}
        </Badge>
        <h1 class="text-4xl font-semibold tracking-tight text-balance sm:text-6xl">{t.home.title}</h1>
        <p class="max-w-2xl text-lg leading-relaxed text-muted-foreground">{t.home.lead}</p>
      </div>
      <Finder
        client:load
        t={t.finder}
        tokens={t.tokens}
        lang={LOCALES[locale].htmlLang}
        domainHref={localePath(locale, "/{domain}")}
      />
      <ul class="flex flex-wrap gap-x-8 gap-y-2 text-sm text-muted-foreground">
        {t.home.facts.map((fact) => (
          <li class="flex items-center gap-2"><Check className="size-4 text-positive" />{fact}</li>
        ))}
      </ul>
    </div>
  </section>

  <LogoStrip locale={locale} />

  <div class="mx-auto flex max-w-6xl flex-col gap-28 px-4 pt-24 sm:px-6">
    <section class="flex flex-col gap-12">
      <SectionHeading eyebrow={t.home.howEyebrow} title={t.home.howTitle} />
      <ol class="grid gap-10 md:grid-cols-3">
        {t.home.how.map((step, i) => (
          <li class="flex flex-col gap-3 border-t border-border pt-6">
            <span class="flex size-8 items-center justify-center rounded-full bg-accent text-sm font-semibold text-accent-foreground">{i + 1}</span>
            <h3 class="text-lg font-semibold">{step.title}</h3>
            <p class="text-sm leading-relaxed text-muted-foreground">{step.body}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="flex flex-col gap-8">
      <SectionHeading eyebrow={t.home.patternsEyebrow} title={t.home.patternsTitle} lead={t.home.patternsLead} />
      <Table>
        <TableHeader>
          <TableRow>
            <TableHead>{t.patterns.colFormat}</TableHead>
            <TableHead className="hidden sm:table-cell" />
            <TableHead className="text-right">{t.patterns.colExample}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {topPatterns.map((p) => (
            <TableRow>
              <TableCell className="py-3.5">
                <a href={localePath(locale, `/patterns/${p.id}`)} class="text-base hover:underline">
                  <AddressFormat template={p.template} labels={t.tokens} />
                </a>
              </TableCell>
              <TableCell className="hidden text-muted-foreground sm:table-cell">{patternLabel(t, p.id)}</TableCell>
              <TableCell className="text-right font-medium">{applyTemplate(p.template, person)}@acme.com</TableCell>
            </TableRow>
          ))}
        </TableBody>
      </Table>
      <LinkButton variant="outline" class="self-start" href={localePath(locale, "/patterns")}>{t.home.patternsAll}</LinkButton>
    </section>
  </div>

  <div class="mt-28 border-y border-border bg-band">
    <div class="mx-auto flex max-w-6xl flex-col gap-24 px-4 py-24 sm:px-6">
      <section id="api" class="grid scroll-mt-24 gap-10 lg:grid-cols-[1fr_1.5fr]">
        <div class="flex flex-col gap-6">
          <SectionHeading eyebrow={t.home.apiEyebrow} title={t.home.apiTitle} lead={t.home.apiLead} />
          <ul class="flex flex-col divide-y divide-border border-y border-border text-sm">
            {endpoints.map((e) => (
              <li class="flex items-center gap-3 py-3">
                <Badge variant={e.method === "GET" ? "secondary" : "default"} className="w-12 justify-center font-mono">{e.method}</Badge>
                <code class="font-mono text-[13px]">{e.path}</code>
              </li>
            ))}
          </ul>
        </div>
        <CodeTabs client:visible samples={apiSamples(origin, t.examplePerson.name)} copyLabel={t.finder.copy} copiedLabel={t.finder.copied} />
      </section>

      <section id="mcp" class="grid scroll-mt-24 gap-10 lg:grid-cols-[1fr_1.5fr]">
        <div class="flex flex-col gap-6">
          <SectionHeading eyebrow={t.home.mcpEyebrow} title={t.home.mcpTitle} lead={t.home.mcpLead} />
          <ol class="flex flex-col gap-3 text-sm">
            {t.home.mcpSteps.map((step, i) => (
              <li class="flex items-center gap-3">
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-accent text-xs font-semibold text-accent-foreground">{i + 1}</span>
                {step}
              </li>
            ))}
          </ol>
        </div>
        <CodeTabs client:visible samples={mcpSamples(origin)} copyLabel={t.finder.copy} copiedLabel={t.finder.copied} />
      </section>
    </div>
  </div>

  <section class="bg-primary text-primary-foreground">
    <div class="mx-auto grid max-w-6xl gap-12 px-4 py-20 sm:px-6 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div class="flex flex-col gap-4">
        <p class="text-sm font-semibold text-primary-foreground/75">{t.home.freeEyebrow}</p>
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">{t.home.freeTitle}</h2>
        <p class="max-w-xl text-lg leading-relaxed text-primary-foreground/80">{t.home.freeLead}</p>
        <div class="mt-4 flex flex-wrap gap-3">
          <LinkButton variant="secondary" size="lg" href={`${home}#find`}>{t.home.freeCtaFind}</LinkButton>
          <LinkButton
            variant="outline"
            size="lg"
            class="border-primary-foreground/30 bg-transparent text-primary-foreground hover:bg-primary-foreground/10 hover:text-primary-foreground dark:bg-transparent"
            href={`${home}#api`}
          >
            {t.home.freeCtaApi}
          </LinkButton>
        </div>
      </div>
      <div class="flex flex-col gap-6 border-primary-foreground/20 lg:border-l lg:pl-12">
        <p class="flex items-baseline gap-3">
          <span class="text-6xl font-semibold tracking-tight">{t.home.freePrice}</span>
          <span class="text-primary-foreground/75">{t.home.freePriceNote}</span>
        </p>
        <ul class="flex flex-col gap-3">
          {t.home.freePoints.map((point) => (
            <li class="flex items-start gap-3"><Check className="mt-0.5 size-5 shrink-0" />{point}</li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 pt-24 sm:px-6">
    <section class="flex flex-col gap-10">
      <SectionHeading eyebrow={t.home.faqEyebrow} title={t.home.faqTitle} />
      <dl class="grid gap-x-12 md:grid-cols-2">
        {t.home.faq.map((item) => (
          <div class="flex flex-col gap-2 border-t border-border py-6">
            <dt class="text-base font-semibold">{item.q}</dt>
            <dd class="text-sm leading-relaxed text-muted-foreground">{item.a}</dd>
          </div>
        ))}
      </dl>
    </section>
  </div>
</Base>
