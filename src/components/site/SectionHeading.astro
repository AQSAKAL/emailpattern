---
import { cn } from "@/lib/utils"

interface Props {
  eyebrow?: string
  title: string
  lead?: string
  /** h2 inside a page; h1 when the heading opens one. */
  as?: "h1" | "h2"
  center?: boolean
}

const { eyebrow, title, lead, as: Tag = "h2", center = false } = Astro.props
---

<div class={cn("flex max-w-3xl flex-col gap-3", center && "mx-auto items-center text-center")}>
  {eyebrow && <p class="text-sm font-semibold text-primary">{eyebrow}</p>}
  <Tag class={cn("font-semibold tracking-tight text-balance", Tag === "h1" ? "text-4xl sm:text-5xl" : "text-3xl sm:text-4xl")}>{title}</Tag>
  {lead && <p class="text-base leading-relaxed text-muted-foreground">{lead}</p>}
</div>
