---
// The mark: a line-drawn @ whose tail stops short and ends in a dot.
// Stroke and dot colours come from the caller, so it works on the frame and on white.
interface Props {
  class?: string
  /** "dark" on the forest frame, "light" on white panels. */
  on?: "dark" | "light"
}

const { class: className, on = "dark" } = Astro.props
const stroke = on === "dark" ? "var(--leaf)" : "var(--token-first)"
const dot = on === "dark" ? "var(--lime)" : "var(--leaf)"
---

<svg viewBox="0 0 24 24" class={className} fill="none" stroke-linecap="round" aria-hidden="true">
  <circle cx="12" cy="12" r="4" stroke={stroke} stroke-width="2.4"></circle>
  <path d="M16 8v5a3 3 0 0 0 6 0v-1a10 10 0 1 0-6.5 9.4" stroke={stroke} stroke-width="2.4"></path>
  <circle cx="18.6" cy="20.6" r="1.4" fill={dot}></circle>
</svg>
