---
import LogoMark from "@/components/site/LogoMark.astro"
import { cn } from "@/lib/utils"

interface Props {
  /** "dark" on the forest frame, "light" on white panels. */
  on?: "dark" | "light"
}

const { on = "dark" } = Astro.props
---

<span class="flex items-center gap-2.5">
  <LogoMark class="size-9 shrink-0" on={on} />
  <span class="text-xl font-semibold tracking-tight">
    email<span class={cn("font-normal", on === "dark" ? "text-white/75" : "text-muted-foreground")}>pattern</span>
  </span>
</span>
