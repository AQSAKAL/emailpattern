---
import { dictionary, localePath, type Locale } from "@/i18n"
import { SHOWCASE } from "@/lib/showcase"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = dictionary(locale)
---

<section class="border-y border-border bg-band">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:px-6">
    <p class="text-center text-sm text-muted-foreground">{t.home.logosTitle}</p>
    <ul class="grid grid-cols-4 gap-x-4 gap-y-6 lg:grid-cols-8">
      {SHOWCASE[locale].map((c) => (
        <li>
          <a
            href={localePath(locale, `/${c.domain}`)}
            class="flex flex-col items-center gap-2 text-muted-foreground/80 transition-colors hover:text-foreground"
            title={c.domain}
          >
            <svg viewBox="0 0 24 24" class="size-8" fill="currentColor" role="img" aria-label={c.name}>
              <path d={c.path} />
            </svg>
            <span class="hidden text-xs font-medium sm:block">{c.name}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
