---
import { dictionary, localePath, type Locale } from "@/i18n"
import { SHOWCASE } from "@/lib/showcase"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = dictionary(locale)
---

<section class="mx-auto flex max-w-7xl flex-col gap-6 px-6 py-12 sm:px-10">
  <p class="eyebrow text-white/50">{t.home.logosTitle}</p>
  <ul class="grid grid-cols-4 gap-x-6 gap-y-8 lg:grid-cols-8">
    {SHOWCASE[locale].map((c) => (
      <li>
        <a
          href={localePath(locale, `/${c.domain}`)}
          class="flex items-center gap-2.5 text-white/55 transition-colors hover:text-white"
          title={c.domain}
        >
          <svg viewBox="0 0 24 24" class="size-7 shrink-0" fill="currentColor" role="img" aria-label={c.name}>
            <path d={c.path} />
          </svg>
          <span class="hidden text-base font-semibold tracking-tight xl:inline">{c.name}</span>
        </a>
      </li>
    ))}
  </ul>
</section>
