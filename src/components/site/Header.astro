---
import PillLink from "@/components/site/PillLink.astro"
import Wordmark from "@/components/site/Wordmark.astro"
import { LOCALE_CODES, dictionary, localePath, type Locale } from "@/i18n"
import { siGithub } from "simple-icons"
import { REPO_URL } from "@/lib/site"
import { cn } from "@/lib/utils"

interface Props {
  locale: Locale
  path: string
}

const { locale, path } = Astro.props
const t = dictionary(locale)
const home = localePath(locale, "/")
const nav = [
  { href: `${home}#find`, label: t.nav.find },
  { href: localePath(locale, "/patterns"), label: t.nav.patterns },
  { href: `${home}#api`, label: t.nav.api },
  { href: `${home}#mcp`, label: t.nav.mcp },
]
---

<header class="mx-auto flex h-20 max-w-7xl items-center justify-between gap-3 px-4 sm:px-10">
  <a href={home} aria-label="EmailPattern" class="group max-sm:[&>span>span:last-child]:hidden"><Wordmark /></a>
  <div class="flex items-center gap-2 sm:gap-6">
    <nav class="hidden items-center gap-7 text-sm text-white/75 md:flex">
      {nav.map((item) => <a class="transition-colors hover:text-white" href={item.href}>{item.label}</a>)}
    </nav>
    <div class="flex items-center gap-0.5 text-xs sm:gap-1" aria-label={t.nav.language}>
      {LOCALE_CODES.map((code) => (
        <a
          href={localePath(code, path)}
          hreflang={code}
          aria-current={code === locale ? "true" : undefined}
          class={cn("rounded-full px-2 py-1 font-semibold", code === locale ? "bg-white/15 text-white" : "text-white/55 hover:text-white")}
        >
          {code.toUpperCase()}
        </a>
      ))}
    </div>
    <a
      href={REPO_URL}
      class="flex size-10 items-center justify-center rounded-full border border-white/30 text-white/80 transition-colors hover:bg-white/10 hover:text-white"
      aria-label="GitHub"
      title="GitHub"
      rel="noopener"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="currentColor" aria-hidden="true"><path d={siGithub.path} /></svg>
    </a>
    <PillLink tone="outline" class="hidden h-10 sm:inline-flex" href={`${home}#api`}>{t.nav.cta}</PillLink>
  </div>
</header>
