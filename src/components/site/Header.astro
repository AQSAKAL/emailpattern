---
import LinkButton from "@/components/site/LinkButton.astro"
import Wordmark from "@/components/site/Wordmark.astro"
import { LOCALE_CODES, dictionary, localePath, type Locale } from "@/i18n"

interface Props {
  locale: Locale
  path: string
}

const { locale, path } = Astro.props
const t = dictionary(locale)
const home = localePath(locale, "/")
const nav = [
  { href: `${home}#find`, label: t.nav.find },
  { href: localePath(locale, "/patterns"), label: t.nav.patterns },
  { href: `${home}#api`, label: t.nav.api },
  { href: `${home}#mcp`, label: t.nav.mcp },
]
---

<header class="sticky top-0 z-40 border-b border-border bg-background/90 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <div class="flex items-center gap-8">
      <a href={home} aria-label="EmailPattern"><Wordmark /></a>
      <nav class="hidden items-center gap-1 md:flex">
        {nav.map((item) => (
          <LinkButton variant="ghost" size="sm" class="text-muted-foreground hover:text-foreground" href={item.href}>{item.label}</LinkButton>
        ))}
      </nav>
    </div>
    <div class="flex items-center gap-3">
      <div class="flex items-center" aria-label={t.nav.language}>
        {LOCALE_CODES.map((code) => (
          <LinkButton
            variant="ghost"
            size="xs"
            class={code === locale ? "font-semibold text-foreground" : "text-muted-foreground"}
            href={localePath(code, path)}
            hreflang={code}
            aria-current={code === locale ? "true" : undefined}
          >
            {code.toUpperCase()}
          </LinkButton>
        ))}
      </div>
      <LinkButton size="sm" class="hidden sm:inline-flex" href={`${home}#api`}>{t.nav.cta}</LinkButton>
    </div>
  </div>
</header>
