---
import "@/styles/global.css"
import Footer from "@/components/site/Footer.astro"
import Header from "@/components/site/Header.astro"
import { DEFAULT_LOCALE, LOCALES, LOCALE_CODES, localePath, type Locale } from "@/i18n"

interface Props {
  locale: Locale
  title: string
  description: string
  /** The page's path without a language prefix, e.g. "/stripe.com". */
  path: string
  /** Thin pages (domains we know little about) stay out of the index. */
  noindex?: boolean
  /** False when only this language's page is indexed: no hreflang alternates then. */
  languages?: boolean
  jsonLd?: object[]
}

const { locale, title, description, path, noindex = false, languages = true, jsonLd = [] } = Astro.props
const site = Astro.site!
const canonical = new URL(localePath(locale, path), site).href
const alternates = LOCALE_CODES.map((code) => ({ code, href: new URL(localePath(code, path), site).href }))
---

<!doctype html>
<html lang={LOCALES[locale].htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && languages && alternates.map((a) => <link rel="alternate" hreflang={LOCALES[a.code].htmlLang} href={a.href} />)}
    {!noindex && languages && <link rel="alternate" hreflang="x-default" href={new URL(localePath(DEFAULT_LOCALE, path), site).href} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EmailPattern" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={LOCALES[locale].ogLocale} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#173a31" />
    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body class="min-h-dvh p-2 sm:p-4">
    <div class="overflow-hidden rounded-[1.75rem] border-[3px] border-ink bg-forest text-white sm:rounded-[2.5rem]">
      <Header locale={locale} path={path} />
      <main>
        <slot />
      </main>
      <Footer locale={locale} />
    </div>
  </body>
</html>
