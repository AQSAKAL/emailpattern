---
import { DEFAULT_LOCALE } from "@/i18n"
import { PAGE_CACHE, isBrowseLetter } from "@/lib/routes"
import BrowseView from "@/views/BrowseView.astro"

export const prerender = false

const locale = DEFAULT_LOCALE
const letter = Astro.params.letter
if (!isBrowseLetter(letter)) return Astro.rewrite("/404")
Astro.response.headers.set("Cache-Control", PAGE_CACHE)
---

<BrowseView locale={locale} letter={letter} after={Astro.url.searchParams.get("after") ?? ""} />
