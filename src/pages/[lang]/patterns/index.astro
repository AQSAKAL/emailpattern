---
import { PAGE_CACHE, prefixedLocale } from "@/lib/routes"
import PatternsView from "@/views/PatternsView.astro"

export const prerender = false

const locale = prefixedLocale(Astro.params.lang)
if (!locale) return Astro.rewrite("/404")
Astro.response.headers.set("Cache-Control", PAGE_CACHE)
---

<PatternsView locale={locale} />
