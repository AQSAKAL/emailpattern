---
import { localePath } from "@/i18n"
import { PAGE_CACHE, prefixedLocale, resolveDomainParam } from "@/lib/routes"
import DomainView from "@/views/DomainView.astro"

export const prerender = false

const locale = prefixedLocale(Astro.params.lang)
const resolved = resolveDomainParam(Astro.params.domain)
if (!locale || resolved.kind === "not-found") return Astro.rewrite("/404")
if (resolved.kind === "redirect") return Astro.redirect(localePath(locale, `/${resolved.domain}`), 301)
Astro.response.headers.set("Cache-Control", PAGE_CACHE)
---

<DomainView locale={locale} domain={resolved.domain} />
