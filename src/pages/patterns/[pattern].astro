---
import { DEFAULT_LOCALE } from "@/i18n"
import { patternById } from "@/lib/email/patterns"
import { PAGE_CACHE } from "@/lib/routes"
import PatternView from "@/views/PatternView.astro"

export const prerender = false

const locale = DEFAULT_LOCALE
const pattern = patternById(Astro.params.pattern ?? "")
if (!pattern) return Astro.rewrite("/404")
Astro.response.headers.set("Cache-Control", PAGE_CACHE)
---

<PatternView locale={locale} pattern={pattern} />
