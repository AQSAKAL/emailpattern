---
import SectionHeading from "@/components/site/SectionHeading.astro"
import LinkButton from "@/components/site/LinkButton.astro"
import Base from "@/layouts/Base.astro"

// Server-rendered so other routes can rewrite to it.
export const prerender = false
---

<Base locale="en" title="Not found · EmailPattern" description="This page does not exist." path="/404" noindex>
  <div class="mx-auto flex max-w-6xl flex-col gap-8 px-4 pt-24 sm:px-6">
    <SectionHeading as="h1" eyebrow="404" title="Nothing at this address." />
    <LinkButton variant="outline" class="self-start" href="/">Find an email format →</LinkButton>
  </div>
</Base>
